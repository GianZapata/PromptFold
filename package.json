{
  "name": "promptfold",
  "displayName": "Promptfold",
  "icon": "./promptfold-icon.png",
  "description": "Pack files, Git diffs and project structure into token-aware prompts for LLMs.",
  "version": "1.0.3",
  "publisher": "gianzapata",
  "keywords": [
    "files",
    "prompt",
    "copy",
    "llm",
    "gpt",
    "tokens",
    "context",
    "ai",
    "claude",
    "chatgpt",
    "git",
    "diff",
    "markdown",
    "files2prompt"
  ],
  "homepage": "https://github.com/GianZapata/PromptFold#readme",
  "bugs": {
    "url": "https://github.com/GianZapata/PromptFold/issues"
  },
  "galleryBanner": {
    "color": "#2b3a4a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GianZapata/PromptFold"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%promptfold.untrustedWorkspaces.description%",
      "restrictedConfigurations": [
        "promptfold.systemMessage",
        "promptfold.allowSensitive"
      ]
    }
  },
  "engines": {
    "vscode": "^1.107.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onView:promptfoldView",
    "onView:promptfold.gitChanges",
    "onView:promptfold.extensions"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "promptfold",
          "title": "%promptfold.container.title%",
          "icon": "resources/promptfold-icon.svg"
        }
      ]
    },
    "views": {
      "promptfold": [
        {
          "id": "promptfoldView",
          "name": "%promptfold.view.name%"
        },
        {
          "id": "promptfold.gitChanges",
          "name": "%promptfold.gitChanges.name%",
          "visibility": "collapsed"
        },
        {
          "id": "promptfold.extensions",
          "name": "%promptfold.extensions.name%",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "promptfold.changeOutputFormat",
        "category": "Promptfold",
        "title": "%promptfold.changeOutputFormat.title%"
      },
      {
        "command": "promptfold.refresh",
        "category": "Promptfold",
        "title": "%promptfold.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "promptfold.copyFiles",
        "category": "Promptfold",
        "title": "%promptfold.copyFiles.title%",
        "icon": "$(copy)"
      },
      {
        "command": "promptfold.copyAsXml",
        "category": "Promptfold",
        "title": "%promptfold.copyAsXml.title%"
      },
      {
        "command": "promptfold.copyAsMarkdown",
        "category": "Promptfold",
        "title": "%promptfold.copyAsMarkdown.title%"
      },
      {
        "command": "promptfold.copyAsPlain",
        "category": "Promptfold",
        "title": "%promptfold.copyAsPlain.title%"
      },
      {
        "command": "promptfold.savePromptAs",
        "category": "Promptfold",
        "title": "%promptfold.savePromptAs.title%",
        "icon": "$(save-as)"
      },
      {
        "command": "promptfold.copyAsFile",
        "category": "Promptfold",
        "title": "%promptfold.copyAsFile.title%"
      },
      {
        "command": "promptfold.clearChecks",
        "category": "Promptfold",
        "title": "%promptfold.clearChecks.title%",
        "icon": "$(clear-all)"
      },
      {
        "command": "promptfold.goBack",
        "category": "Promptfold",
        "title": "%promptfold.goBack.title%",
        "icon": "$(arrow-left)"
      },
      {
        "command": "promptfold.goForward",
        "category": "Promptfold",
        "title": "%promptfold.goForward.title%",
        "icon": "$(arrow-right)"
      },
      {
        "command": "promptfold.copyOpenFiles",
        "category": "Promptfold",
        "title": "%promptfold.copyOpenFiles.title%",
        "icon": "$(files)"
      },
      {
        "command": "promptfold.copyExplorerSelection",
        "category": "Promptfold",
        "title": "%promptfold.copyExplorerSelection.title%"
      },
      {
        "command": "promptfold.previewPrompt",
        "category": "Promptfold",
        "title": "%promptfold.previewPrompt.title%",
        "icon": "$(open-preview)"
      },
      {
        "command": "promptfold.showDetails",
        "category": "Promptfold",
        "title": "%promptfold.showDetails.title%",
        "icon": "$(list-selection)"
      },
      {
        "command": "promptfold.selectAll",
        "category": "Promptfold",
        "title": "%promptfold.selectAll.title%",
        "icon": "$(checklist)"
      },
      {
        "command": "promptfold.selectByExtension",
        "category": "Promptfold",
        "title": "%promptfold.selectByExtension.title%",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "promptfold.selectChanges",
        "category": "Promptfold",
        "title": "%promptfold.selectChanges.title%",
        "icon": "$(git-compare)"
      },
      {
        "command": "promptfold.gitChanges.setScope",
        "category": "Promptfold",
        "title": "%promptfold.gitChanges.setScope.title%",
        "icon": "$(list-selection)"
      },
      {
        "command": "promptfold.gitChanges.setBase",
        "category": "Promptfold",
        "title": "%promptfold.gitChanges.setBase.title%",
        "icon": "$(git-branch)"
      },
      {
        "command": "promptfold.clearGitChanges",
        "category": "Promptfold",
        "title": "%promptfold.clearGitChanges.title%",
        "icon": "$(close)"
      }
    ],
    "submenus": [
      {
        "id": "promptfold.select",
        "label": "%promptfold.select.title%",
        "icon": "$(checklist)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "promptfold.copyExplorerSelection",
          "group": "navigation"
        },
        {
          "command": "promptfold.selectByExtension",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "promptfold.selectByExtension",
          "when": "view == promptfoldView && viewItem == folder",
          "group": "navigation"
        },
        {
          "command": "promptfold.selectChanges",
          "when": "view == promptfoldView && viewItem == repository",
          "group": "navigation"
        },
        {
          "command": "promptfold.gitChanges.setScope",
          "when": "view == promptfold.gitChanges && viewItem == gitRepo",
          "group": "inline"
        },
        {
          "command": "promptfold.gitChanges.setBase",
          "when": "view == promptfold.gitChanges && viewItem == gitRepo",
          "group": "inline"
        },
        {
          "command": "promptfold.clearGitChanges",
          "when": "view == promptfold.gitChanges",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "promptfold.copyFiles",
          "when": "view == promptfoldView",
          "group": "navigation@1"
        },
        {
          "command": "promptfold.previewPrompt",
          "when": "view == promptfoldView",
          "group": "navigation@2"
        },
        {
          "submenu": "promptfold.select",
          "when": "view == promptfoldView",
          "group": "navigation@3"
        },
        {
          "command": "promptfold.selectChanges",
          "when": "view == promptfoldView",
          "group": "navigation@4"
        },
        {
          "command": "promptfold.clearChecks",
          "when": "view == promptfoldView",
          "group": "navigation@5"
        },
        {
          "command": "promptfold.copyOpenFiles",
          "when": "view == promptfoldView",
          "group": "1_overflow@1"
        },
        {
          "command": "promptfold.refresh",
          "when": "view == promptfoldView",
          "group": "1_overflow@2"
        },
        {
          "command": "promptfold.showDetails",
          "when": "view == promptfoldView",
          "group": "1_overflow@3"
        },
        {
          "command": "promptfold.savePromptAs",
          "when": "view == promptfoldView",
          "group": "1_overflow@4"
        },
        {
          "command": "promptfold.copyAsFile",
          "when": "view == promptfoldView",
          "group": "1_overflow@5"
        }
      ],
      "promptfold.select": [
        {
          "command": "promptfold.selectAll",
          "group": "1_select@1"
        },
        {
          "command": "promptfold.selectByExtension",
          "group": "1_select@2"
        },
        {
          "command": "promptfold.clearChecks",
          "group": "1_select@3"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "promptfoldView",
        "when": "workbenchState == empty",
        "contents": "%promptfold.welcome%"
      }
    ],
    "keybindings": [
      {
        "command": "promptfold.refresh",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "focusedView == 'promptfoldView'",
        "title": "%promptfold.refresh.title%"
      },
      {
        "command": "promptfold.copyFiles",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == 'promptfoldView'",
        "title": "%promptfold.copyFiles.title%"
      },
      {
        "command": "promptfold.clearChecks",
        "key": "ctrl+shift+x",
        "mac": "cmd+shift+x",
        "when": "focusedView == 'promptfoldView'",
        "title": "%promptfold.clearChecks.title%"
      },
      {
        "command": "promptfold.copyOpenFiles",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "focusedView == 'promptfoldView'",
        "title": "%promptfold.copyOpenFiles.title%"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "%promptfold.config.title%",
      "properties": {
        "promptfold.systemMessage": {
          "type": "string",
          "description": "%promptfold.systemMessage.description%",
          "default": ""
        },
        "promptfold.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%promptfold.exclude.description%"
        },
        "promptfold.allowSensitive": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%promptfold.allowSensitive.description%"
        },
        "promptfold.maxFileBytes": {
          "type": "number",
          "default": 1048576,
          "description": "%promptfold.maxFileBytes.description%"
        },
        "promptfold.maxFiles": {
          "type": "number",
          "default": 5000,
          "description": "%promptfold.maxFiles.description%"
        },
        "promptfold.maxTotalBytes": {
          "type": "number",
          "default": 8388608,
          "description": "%promptfold.maxTotalBytes.description%"
        },
        "promptfold.tokenBudget": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%promptfold.tokenBudget.description%"
        },
        "promptfold.includeGenerated": {
          "type": "boolean",
          "default": false,
          "description": "%promptfold.includeGenerated.description%"
        },
        "promptfold.includeTree": {
          "type": "boolean",
          "default": true,
          "description": "%promptfold.includeTree.description%"
        },
        "promptfold.compactWhitespace": {
          "type": "boolean",
          "default": false,
          "description": "%promptfold.compactWhitespace.description%"
        },
        "promptfold.confirmIgnoredFolders": {
          "type": "boolean",
          "default": true,
          "description": "%promptfold.confirmIgnoredFolders.description%"
        },
        "promptfold.outputFormat": {
          "type": "string",
          "enum": [
            "xml",
            "markdown",
            "plain"
          ],
          "default": "xml",
          "description": "%promptfold.outputFormat.description%"
        },
        "promptfold.diffMode": {
          "type": "string",
          "enum": [
            "diffAndFiles",
            "diffOnly",
            "filesOnly"
          ],
          "default": "diffAndFiles",
          "description": "%promptfold.diffMode.description%"
        },
        "promptfold.extensionPresets": {
          "type": "object",
          "default": {},
          "description": "%promptfold.extensionPresets.description%"
        },
        "promptfold.ignoredExtensions": {
          "type": "string",
          "description": "%promptfold.ignoredExtensions.description%",
          "default": "png,jpg,jpeg,gif,svg"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write src test scripts .vscode-test.mjs eslint.config.mjs",
    "format:check": "prettier --check src test scripts .vscode-test.mjs eslint.config.mjs",
    "compile:integration": "tsc -p tsconfig.integration.json",
    "test:unit": "node -e \"for (const dir of ['out-test/src', 'out-test/test']) require('fs').rmSync(dir, { recursive: true, force: true })\" && tsc -p tsconfig.test.json && node --test out-test/test/*.test.js",
    "pretest:vscode": "node scripts/make-fixture.mjs && npm run compile && node -e \"require('fs').rmSync('out-test/integration', { recursive: true, force: true })\" && npm run compile:integration",
    "test:vscode": "vscode-test",
    "compile:smoke": "node -e \"require('fs').rmSync('out-test/smoke', { recursive: true, force: true })\" && tsc -p tsconfig.smoke.json",
    "test:smoke": "npm run compile:smoke && node scripts/smoke.mjs",
    "test": "npm run test:unit && npm run test:vscode"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.1",
    "@types/vscode": "1.107.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "mocha": "^12.0.3",
    "ovsx": "1.2.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ignore": "^7.0.12"
  }
}
